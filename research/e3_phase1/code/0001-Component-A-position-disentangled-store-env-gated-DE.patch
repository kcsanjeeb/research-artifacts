@@ -103,6 +103,20 @@ class RotaryEmbeddingESM(torch.nn.Module):
 
         return ((x.float() * cos) + (self.rotate_half(x).float() * sin)).to(dtype)
 
+    # DECAF Component A: rotate with explicit per-token positions (the position
+    # sidecar), instead of the stock contiguous range. Computes cos/sin directly
+    # for the requested positions — no dense position table, same fp32 math as
+    # apply_rotary_pos_emb. x: (..., N, D); pos: (N,) long tensor of positions.
+    def apply_rotary_with_positions(self, x: torch.Tensor, pos: torch.Tensor) -> torch.Tensor:
+        dtype = x.dtype
+        pos = pos.to(device=x.device)
+        freqs = torch.outer(pos.float() * self.distance_scale, self.inv_freq)  # (N, D/2)
+        emb = torch.cat((freqs, freqs), dim=-1)  # (N, D)
+        view_idx = (None,) * (x.dim() - 2) + (slice(None), slice(None))  # (1,...,1,N,D)
+        cos = emb.cos()[view_idx]
+        sin = emb.sin()[view_idx]
+        return ((x.float() * cos) + (self.rotate_half(x).float() * sin)).to(dtype)
+
 
     def forward(self, q: torch.Tensor, k: torch.Tensor, seq_dim= -2) -> Tuple[torch.Tensor, torch.Tensor]:

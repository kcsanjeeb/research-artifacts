+        assert self.retrieved_block_indices is not None
+        arange_block = torch.arange(self.block_size)
+        positions = []
+        for u in range(self.num_units):
+            starts = [self.block_starts[u][b] for b in self.retrieved_block_indices[u]]
+            pos = (torch.as_tensor(starts)[:, None] + arange_block[None, :]).reshape(-1)
+            positions.append(pos)

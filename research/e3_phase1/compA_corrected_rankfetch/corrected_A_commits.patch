From 8ffe916943b43671f76442843e88c866bf7fdadb Mon Sep 17 00:00:00 2001
From: Hadi602 <muhammad.rashid.602@gmail.com>
Date: Sun, 27 Sep 2026 21:52:01 +0800
Subject: [PATCH 2/3] trapcheck: mode=rankqa for corrected Component A

TR1: rank plumbing (contiguous buffer-rank positions on retrieval prefill,
next_pos unset so decoding continues from carried rank positions).
TR2: late-stream stock equivalence - all 0fa75cb3 questions answered against
the full 420-frame (~84k-token) store, the exact-mode failure position,
must match W2.5 stock CSV answers.
---
 verification/decaf_trapcheck.py | 109 ++++++++++++++++++++++++++++++++
 1 file changed, 109 insertions(+)

diff --git a/verification/decaf_trapcheck.py b/verification/decaf_trapcheck.py
index e571c7f..4be0942 100644
--- a/verification/decaf_trapcheck.py
+++ b/verification/decaf_trapcheck.py
@@ -22,6 +22,14 @@ Runs in two modes (single process each):
     T3c encode invariance: DECAF-mode encode == stock-mode encode bit-exact
     T3d full greedy QA smoke (retrieval + prefill + decode) runs clean
 
+  mode=rankqa (subprocess with DECAF_POSITION_FREE=1 DECAF_FETCH_RANK=1):
+    TR1 rank plumbing: retrieval prefill carries contiguous buffer-RANK
+        positions (slot order), next_pos unset (decoding continues from the
+        carried rank positions)
+    TR2 late-stream stock equivalence: all 0fa75cb3 questions answered against
+        the full 420-frame (~84k-token) store - the exact-mode failure
+        position - must match W2.5 stock CSV answers
+
 Usage: python verification/decaf_trapcheck.py <out_dir> <mode>
 """
 import json
@@ -345,6 +353,107 @@ elif MODE == 'qa':
     with torch.inference_mode():
         main()
 
+
+
+elif MODE == 'rankqa':
+
+    def main():
+        # Gate-1 corrected trap check (2026-09-27): rank-remapped fetch
+        # positions must reproduce stock answers on questions asked against a
+        # FULL store (the exact-mode failure mode: 22.3 vs 54.1 with
+        # mid-sentence truncation at ~86k-token streaming positions). Runs
+        # with DECAF_POSITION_FREE=1 DECAF_FETCH_RANK=1 on the 0.5B; stock
+        # reference = W2.5 answers_0.5b CSV (T5 already proved the flag-off
+        # repo == W2.5 stock in this harness, same interleave).
+        from model.llava_onevision_rekv import load_model
+        from model.attention.kv_cache_manager import PositionalKV
+        from model.attention.rekv_attention import DECAF_POSITION_FREE, DECAF_FETCH_RANK
+        assert DECAF_POSITION_FREE and DECAF_FETCH_RANK, \
+            'mode=rankqa must run with DECAF_POSITION_FREE=1 DECAF_FETCH_RANK=1'
+        import pandas as pd
+        model, processor = load_model(model_path=MODEL, n_local=15000, topk=64, chunk_size=1)
+
+        anno = json.load(open(ANNO))
+        vs = [v for v in anno if v['video_id'].startswith('0fa75cb3')][0]
+        convs = [c for c in vs['conversations'] if c['end_time'] * SAMPLE_FPS <= N_FRAMES_QA]
+        assert len(convs) >= 2, f'need >=2 questions within {N_FRAMES_QA} frames'
+        w25 = pd.read_csv(W25_CSV)
+        frames, _ = load_video_frames(vs['video_path'], N_FRAMES_QA)
+        model.clear_cache()
+        model.encode_init_prompt()
+        model._current_video_id = vs['video_id']
+        n_init = int(model.kv_cache[0].n_init)
+
+        checks, answers = [], []
+        start_idx = 0.0
+        for qi, c in enumerate(convs):
+            end_idx = c['end_time'] * SAMPLE_FPS
+            if end_idx > start_idx:
+                model.encode_video(torch.from_numpy(frames[int(start_idx):int(end_idx)]))
+                start_idx = end_idx
+            # TR1 plumbing: retrieval prefill must carry contiguous RANK
+            # positions (buffer slot order), next_pos unset (decoding continues
+            # from carried rank positions).
+            for layer_kv in model.kv_cache:
+                layer_kv.set_retrieval()
+            input_ids = torch.as_tensor([processor.tokenizer(c['question']).input_ids],
+                                        device=model.device)
+            out = model.language_model(input_ids=input_ids, use_cache=True,
+                                       past_key_values=model.kv_cache)
+            pkv = out.past_key_values[0]
+            assert isinstance(pkv, PositionalKV), 'retrieval must return PositionalKV'
+            cm0 = model.kv_cache[0]
+            pos = [int(x) for x in pkv.positions]
+            n_blk = (len(pos) - n_init) // N_FRAME_TOKENS
+            exp_buf = list(range(n_init)) + [n_init + i for i in range(n_blk * N_FRAME_TOKENS)]
+            idx0 = [int(b) for b in cm0.retrieved_block_indices[0]]
+            checks.append({
+                'qi': qi, 'question': c['question'][:100], 'end_time': c['end_time'],
+                'store_blocks_at_query': int(cm0.num_global_block),
+                'manager_length_tokens': int(cm0.length),
+                'rank_pos_ok': pos == exp_buf,
+                'next_pos_unset': pkv.next_pos is None,
+                'retrieved_layer0_head': idx0[:8],
+                'retrieved_in_pos_order': idx0 == sorted(idx0),
+                'n_retrieved': len(idx0),
+            })
+            for layer_kv in model.kv_cache:
+                layer_kv.reset_retrieval()
+            # TR2: full greedy answer, compared to the W2.5 stock CSV row.
+            pred = model.question_answering(
+                {'question': c['question'], 'prompt': model.get_prompt(c['question'])},
+                max_new_tokens=256)
+            ref = w25[(w25.video_id == vs['video_id']) & (w25.question == c['question'])]['pred_answer']
+            answers.append({'qi': qi, 'question': c['question'][:100], 'end_time': c['end_time'],
+                            'pred': pred, 'w25_pred': ref.iloc[0] if len(ref) else None,
+                            'match': (ref.iloc[0] if len(ref) else None) == pred.replace('\n', ''),
+                            'pred_chars': len(pred)})
+
+        save('TR1_rank_plumbing', {'n_init': n_init, 'n_questions': len(convs),
+                                   'store_frames': int(start_idx),
+                                   'checks': checks})
+        save('TR2_late_stream_stock_equivalence', {
+            'video_id': vs['video_id'],
+            'note': ('questions answered with the full 420-frame (840 s) store ~84k tokens '
+                     '+ init - the exact-mode failure position; rank mode must match '
+                     'W2.5 stock answers'),
+            'checks': answers})
+        ok_plumbing = all(c['rank_pos_ok'] and c['next_pos_unset'] for c in checks)
+        n_match = sum(a['match'] for a in answers)
+        verdict = {
+            'gate_rank_plumbing': 'PASS' if ok_plumbing else 'FAIL',
+            'gate_late_stream_stock_equiv':
+                'PASS' if n_match == len(answers) else 'FAIL',
+            'n_stock_matches': f'{n_match}/{len(answers)}',
+        }
+        verdict['OVERALL'] = 'PASS' if all(v == 'PASS' for v in verdict.values()) else 'FAIL'
+        save('verdict', verdict)
+        print('RANKQA_MODE_DONE', json.dumps(verdict))
+
+    with torch.inference_mode():
+        main()
+
+
 elif MODE == 'compare':
     ref = np.load(os.path.join(OUT, 'T3c_encode_reference.npy'))
     got = np.load(os.path.join(OUT, 'T3c_encode_snapshot.npy'))
-- 

From fe7af47352cae03a1f1dc10857900f5dd6ce1d3c Mon Sep 17 00:00:00 2001
From: Hadi602 <muhammad.rashid.602@gmail.com>
Date: Sun, 27 Sep 2026 21:42:23 +0800
Subject: [PATCH 1/3] Component A corrected (Gate 1 post-mortem):
 DECAF_FETCH_RANK=1 rank-remapped fetch positions

Gate 1 (exact-position fetch) failed 22.3 vs 54.1: exact streaming positions
(~86k tokens on a full RVS-Ego stream) exceed the model in-distribution RoPE
range and collapse late-stream generation. Corrected Component A keeps the
position-free store, content-key retrieval, and position sidecar, but assigns
fetched blocks buffer-RANK positions (contiguous from n_init in retrieval
buffer load order - the stock ReKV convention), with question/decoding tokens
continuing right after the buffer. In rank mode next_pos is left unset so
decoding continues from the carried rank positions.

- kv_cache_manager: DECAF_FETCH_RANK env switch
- rekv_attention: rank position assignment branch (score order, contiguous);
  exact path (DECAF_POSITION_FREE) kept for the record
- trapcheck: fix OVERALL verdict aggregation (filter on keys, not values -
  float metric entries crashed the filter)
---
 model/attention/kv_cache_manager.py | 12 +++++++-
 model/attention/rekv_attention.py   | 47 +++++++++++++++++++++--------
 verification/decaf_trapcheck.py     |  5 +--
 3 files changed, 49 insertions(+), 15 deletions(-)

diff --git a/model/attention/kv_cache_manager.py b/model/attention/kv_cache_manager.py
index ce2784c..3435a97 100644
--- a/model/attention/kv_cache_manager.py
+++ b/model/attention/kv_cache_manager.py
@@ -7,12 +7,22 @@ from .dot_production_attention import get_multi_stage_dot_production_attention
 
 
 # DECAF Component A: environment switch.
-# DECAF_POSITION_FREE=1 -> position-disentangled store mode:
+# DECAF_POSITION_FREE=1 -> position-disentangled store mode (exact positions):
 #   retrieval keeps scoring on content (pre-RoPE) keys, but fetched blocks are
 #   rotated to their EXACT original positions (the sidecar) before attention,
 #   and question/decoding tokens use their true streaming positions.
+# DECAF_FETCH_RANK=1 -> corrected Component A (Gate-1 post-mortem 2026-09-27):
+#   same position-free store + content retrieval + position sidecar (recording
+#   true order for Phase 2), but fetched blocks are rotated to buffer-RANK
+#   positions (contiguous from n_init, in retrieval-buffer load order - the
+#   stock ReKV convention) so all fetch positions stay in-distribution; the
+#   question/decoding tokens continue right after the buffer. Exact streaming
+#   positions (~86k tokens for a full RVS-Ego stream) exceed the model's
+#   in-distribution RoPE range and collapse late-stream generation (22.3 vs
+#   54.1 measured), which is why the exact path failed Gate 1.
 # Unset -> stock ReKV behavior (bit-identical to the W2.5-validated code).
 DECAF_POSITION_FREE = os.environ.get('DECAF_POSITION_FREE', '0') == '1'
+DECAF_FETCH_RANK = os.environ.get('DECAF_FETCH_RANK', '0') == '1'
 
 
 # A KV cache entry that also carries the exact position id of every token.
diff --git a/model/attention/rekv_attention.py b/model/attention/rekv_attention.py
index 2c5ea35..1725078 100644
--- a/model/attention/rekv_attention.py
+++ b/model/attention/rekv_attention.py
@@ -2,7 +2,7 @@ import copy
 import torch
 from typing import Optional
 
-from .kv_cache_manager import ContextManager, PositionalKV, DECAF_POSITION_FREE
+from .kv_cache_manager import ContextManager, PositionalKV, DECAF_POSITION_FREE, DECAF_FETCH_RANK
 from .dot_production_attention import get_multi_stage_dot_production_attention
 
 
@@ -70,20 +70,39 @@ def rekv_attention_forward(
                 else:  # retrieve based on pre-computed retrieved_block_indices
                     past_k, past_v = past_key_value.get_retrieved_kv()
                 updata_kv_cache = False  # We do not update KV cache with the input KV (h_k, h_v) because we only use it for retrieval
-                if DECAF_POSITION_FREE:
-                    # Rotate-on-fetch: exact positions for the retrieved blocks
-                    # come from the sidecar; init tokens keep positions 0..n_init-1
-                    # (identical to the stock buffer layout); the incoming question
-                    # tokens continue at their true streaming positions.
+                if DECAF_POSITION_FREE or DECAF_FETCH_RANK:
+                    # Rotate-on-fetch via the PositionalKV machinery, on the
+                    # pre-RoPE content store. Two position conventions:
+                    #   exact (DECAF_POSITION_FREE): block positions come from
+                    #     the sidecar; question/decoding continue at true
+                    #     streaming positions (past_key_value.length).
+                    #   rank (DECAF_FETCH_RANK): the block loaded at buffer slot
+                    #     cnt gets rank position n_init + cnt*block_size + j -
+                    #     contiguous, in retrieval-buffer load order, the stock
+                    #     ReKV convention, keeping every fetch position inside
+                    #     the model's in-distribution RoPE range. The question
+                    #     continues right after the buffer (n_past). Up to a
+                    #     window-relative shift in decoding this equals the
+                    #     stock contiguous rotation (RoPE logits depend only on
+                    #     position differences within one attention call).
                     assert past_key_value.num_units == 1, 'DECAF position-free mode assumes batch size 1'
-                    block_pos = past_key_value.get_retrieved_positions()[0].to(h_k.device)
                     n_past = past_k.size(2)
                     init_pos = torch.arange(past_key_value.n_init, device=h_k.device)
+                    if DECAF_FETCH_RANK:
+                        n_blk = (n_past - init_pos.numel()) // past_key_value.block_size
+                        block_pos = (
+                            torch.arange(n_blk, device=h_k.device, dtype=torch.long)[:, None]
+                            * past_key_value.block_size
+                            + torch.arange(past_key_value.block_size, device=h_k.device, dtype=torch.long)[None, :]
+                        ).reshape(-1) + past_key_value.n_init
+                    else:
+                        block_pos = past_key_value.get_retrieved_positions()[0].to(h_k.device)
                     assert n_past == init_pos.numel() + block_pos.numel(), \
                         f'{n_past} vs {init_pos.numel()} + {block_pos.numel()}'
+                    q_base = n_past if DECAF_FETCH_RANK else past_key_value.length
                     decaf_pos = torch.cat([
                         init_pos, block_pos,
-                        torch.arange(h_k.size(2), device=h_k.device, dtype=torch.long) + past_key_value.length,
+                        torch.arange(h_k.size(2), device=h_k.device, dtype=torch.long) + q_base,
                     ])
             else:  # sliding-window attention
                 past_k = past_key_value[0]
@@ -125,12 +144,16 @@ def rekv_attention_forward(
             else:
                 if decaf_pos is not None:
                     # exclude the incoming tokens, as in stock; carry positions only.
-                    # next_pos: the question's true streaming position (store length
-                    # at query time) so prefill/decoding continue at exact positions
-                    # even though the retrieved buffer only holds a subset of blocks.
+                    # next_pos (exact mode only): the question's true streaming
+                    # position (store length at query time) so prefill/decoding
+                    # continue at exact positions even though the retrieved buffer
+                    # only holds a subset of blocks. Rank mode leaves next_pos
+                    # unset: decoding continues from the carried rank positions
+                    # (past_pos[-1] + 1), matching the stock contiguous layout.
                     n_past = past_k.size(2)
                     current_key_value = PositionalKV(past_k, past_v, decaf_pos[:n_past])
-                    current_key_value.next_pos = int(past_key_value.length)
+                    if DECAF_POSITION_FREE and not DECAF_FETCH_RANK:
+                        current_key_value.next_pos = int(past_key_value.length)
                 else:
                     current_key_value = (past_k, past_v)
 
diff --git a/verification/decaf_trapcheck.py b/verification/decaf_trapcheck.py
index 826d54f..e571c7f 100644
--- a/verification/decaf_trapcheck.py
+++ b/verification/decaf_trapcheck.py
@@ -148,7 +148,8 @@ if MODE == 'encode':
             x = torch.from_numpy(np.asarray(dump_pre)).permute(0, 2, 1, 3).cuda()  # (F,Hkv,196,Dh)
             pos = (n_init + (torch.arange(n_first * Hkv) // Hkv)[:, None] * N_FRAME_TOKENS
                    + torch.arange(N_FRAME_TOKENS)[None, :])  # (F*Hkv, 196) row r <-> (f=r//Hkv, h=r%Hkv)
-            rot = rope.apply_rotary_with_positions(x.reshape(n_first * Hkv, N_FRAME_TOKENS, Dh), pos.cuda())
+            rot = rope.apply_rotary_with_positions(
+                x.permute(0, 1, 2, 3).reshape(-1, Dh), pos.reshape(-1).cuda())
             rot = rot.reshape(n_first, Hkv, N_FRAME_TOKENS, Dh).permute(0, 2, 1, 3).half().cpu().numpy()
             e_rot = rel_err(torch.from_numpy(rot), torch.from_numpy(np.asarray(dump_post)))
             t2[f'layer{li}'] = {'dump_Kpre_rel_err': e_pre, 'rotary_vs_dump_Kpost_rel_err': e_rot}
@@ -212,7 +213,7 @@ if MODE == 'encode':
             'max_stored_k_rel_err': g1, 'max_stored_v_rel_err': g1v,
             'max_rotary_rel_err': g2,
         }
-        verdict['OVERALL'] = 'PASS' if all(v == 'PASS' for v in verdict.values() if v.startswith('gate')) else 'FAIL'
+        verdict['OVERALL'] = 'PASS' if all(v == 'PASS' for k, v in verdict.items() if k.startswith('gate')) else 'FAIL'
         save('verdict', verdict)
         print('ENCODE_MODE_DONE', json.dumps(verdict))
 
